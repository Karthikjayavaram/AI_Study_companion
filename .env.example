# ==============================================================================
# AI Study Companion - Environment Configuration Template (.env.example)
# ==============================================================================

# Application Environment
APP_NAME="AI Study Companion"
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=change-this-insecure-secret-key-for-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (Deployment Target: PostgreSQL + pgvector)
# Format: postgresql+psycopg2://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_study_companion
# Lightweight local test/fallback:
# DATABASE_URL=sqlite:///./study_companion_dev.db

# Redis & Celery Background Workers (Optional for background task offloading)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# AI Provider Architecture (Hugging Face Inference API)
AI_PROVIDER=huggingface

# Hugging Face Configuration (Backend-only credentials)
HF_API_KEY=
HF_CHAT_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
HF_TEMPERATURE=0.2
HF_MAX_TOKENS=1024
HF_TIMEOUT_SECONDS=30.0

# Text Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Storage Configuration (Deployment target: Supabase Storage)
STORAGE_BACKEND=supabase
LOCAL_STORAGE_DIR=./storage/uploads
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=ai-study-companion

# AI Observability & Tracing (LangSmith - Backend-only credentials)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai-study-companion

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Frontend Configuration (Only public configuration exposed to browser)
# VITE_API_URL=/api/v1

