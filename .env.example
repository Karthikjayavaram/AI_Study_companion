# ==============================================================================
# AI Study Companion - Environment Configuration Template
# ==============================================================================

# Application Environment
APP_NAME="AI Study Companion"
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=change-this-insecure-secret-key-for-production-min-32-chars

# Database Configuration (PostgreSQL + pgvector)
# Format: postgresql+psycopg2://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_study_companion
# For running tests or lightweight local dev without PostgreSQL, can fallback to:
# DATABASE_URL=sqlite:///./test_study_companion.db

# Redis & Celery Background Workers
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# AI Provider Architecture
AI_PROVIDER=huggingface

# Hugging Face Inference API Configuration (Primary Provider)
HF_API_KEY=your_huggingface_api_key_here
HF_CHAT_MODEL=mistralai/Mistral-7B-Instruct-v0.3
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
HF_TEMPERATURE=0.2
HF_MAX_TOKENS=1024
HF_TIMEOUT_SECONDS=30.0

# Text Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=50


# Storage Configuration (Local or S3-compatible)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage/uploads
# S3 / MinIO Settings (optional if STORAGE_BACKEND=s3)
S3_BUCKET_NAME=ai-study-companion
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=

# AI Observability & Tracing (Langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
AI_TRACING_ENABLED=false

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
